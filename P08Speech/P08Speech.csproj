<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Identyfikator powiązanego pliku secrets.json (tworzy go: dotnet user-secrets init) -->
    <UserSecretsId>32dzien15-p08speech</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK Azure AI Speech (rozpoznawanie i synteza mowy) -->
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.52.0" />
    <!-- Czytanie User Secrets i zmiennych środowiskowych -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

</Project>
