<Window x:Class="P03WeatherForecastWPF.Client.Views.ShopProductsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:P03WeatherForecastWPF.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
        Title="Sklep – produkty z API" Height="560" Width="980">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pasek narzędzi: każdy przycisk to komenda; CanExecute sam je wyłącza -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Odśwież" Command="{Binding LoadProductsCommand}" Padding="12,4" />
            <Button Content="Nowy" Command="{Binding NewProductCommand}" Padding="12,4" Margin="8,0,0,0" />
            <Button Content="Edytuj" Command="{Binding EditProductCommand}" Padding="12,4" Margin="8,0,0,0" />
            <Button Content="Usuń" Command="{Binding DeleteProductCommand}" Padding="12,4" Margin="8,0,0,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0" />
        </StackPanel>

        <ProgressBar Grid.Row="1" Height="6" IsIndeterminate="True" Margin="0,6"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- ListView + GridView: tabela; dwuklik w wiersz = edycja -->
        <ListView Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
            <ListView.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProductCommand}" />
            </ListView.InputBindings>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="50" />
                    <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Title}" Width="220" />
                    <GridViewColumn Header="Opis" DisplayMemberBinding="{Binding Description}" Width="340" />
                    <GridViewColumn Header="Kod" DisplayMemberBinding="{Binding Barcode}" Width="110" />
                    <GridViewColumn Header="Cena" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2} zł}" Width="100" />
                    <GridViewColumn Header="Premiera" DisplayMemberBinding="{Binding ReleaseDate, StringFormat=d}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
    </Grid>
</Window>
